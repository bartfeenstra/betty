[run]
omit =
    */_dev*
    betty/sphinx/extension/betty.py
branch = True
concurrency =
    multiprocessing
    thread
parallel = True
source = betty

[report]
omit =
    */_dev*
    betty/sphinx/extension/betty.py
exclude_also =
    ^\s*pragma: no cover$
    ^\s*def __repr__
    if TYPE_CHECKING:
    @abstractmethod
    @overload
    raise AbstractMethod
    raise Unreachable
show_missing = True
skip_covered = True
skip_empty = True
