{% extends 'base.html.j2' %}
{% set page_title = page_title | default(document.resource.label_plural | localize) %}
{% do document.breadcrumbs.append(
    page_title,
    document.resource
) %}
{% if page > 0 %}
    {% do document.breadcrumbs.append(
        _('Page %(page)s', page=page),
        ('betty://' ~ document.resource.id ~ '/page-' ~ (page + 1))
    ) %}
{% endif %}
{% block page_summary %}
    <p>
        {{ document.resource.label_countable.count(project.ancestry[document.resource.id] | length) | localize | html_lang }}
    </p>
{% endblock %}
