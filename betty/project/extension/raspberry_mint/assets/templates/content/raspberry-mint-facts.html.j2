{% if document.resource is entity_plugin('citation') %}
    {% set facts = document.resource.facts %}
{% elif document.resource is entity_plugin('source') %}
    {% set sources = [document.resource] + document.resource.walk_contains | select('public') | list %}
    {% set facts = sources | map(attribute='citations') | flatten | map(attribute='facts') | flatten | unique %}
{% endif %}
{% if facts is defined %}
    {% set entities = facts | select('public') | list %}
    {% if entities | length %}
        {% include 'entity/list.html.j2' %}
    {% endif %}
{% endif %}
