#, python-brace-format
msgid "\"{hex_value}\" is not a valid hexadecimal color, such as #ffc0cb."
msgstr "\"{hex_value}\" என்பது #ffc0cb போன்ற சரியான எக்சாடெசிமல் வண்ணம் அல்ல."

#, python-brace-format
msgid "\"{invalid_locale}\" is not a valid IETF BCP 47 language tag."
msgstr "\"{invalid_locale}\" என்பது சரியான IETF BCP 47 மொழி குறிச்சொல் அல்ல."

#, python-brace-format
msgid "\"{path}\" is not a directory."
msgstr "\"{path}\" என்பது அடைவு அல்ல."

#, python-brace-format
msgid ""
"\"{value}\" is not a valid machine name: only lowercase letters, digits, "
"and hyphens (-) are allowed."
msgstr ""
"\"{value}\" என்பது செல்லுபடியாகும் இயந்திரப் பெயர் அல்ல: சிறிய எழுத்துக்கள், இலக்கங்கள் "
"மற்றும் ஐபன்கள் (-) மட்டுமே அனுமதிக்கப்படும்."

#, python-format
msgid "%(date)s in %(place)s"
msgstr "%(date)s %(place)s"

#, python-format
msgid "%(event)s of %(subjects)s"
msgstr "%(event)s இன் %(subjects)s"

#, python-format
msgid "%(event)s with %(subjects)s"
msgstr "%(event)s உடன் %(subjects)s"

#, python-format
msgid "%(person_individual_name)s had a child with %(co_parent_labels)s."
msgid_plural ""
"%(person_individual_name)s had %(child_count)s children with "
"%(co_parent_labels)s."
msgstr[0] ""
"%(person_individual_name)s க்கு %(co_parent_labels)s உடன் குழந்தை இருந்தது."
msgstr[1] ""
"%(person_individual_name)s %(co_parent_labels)s உடன் %(child_count)s குழந்தைகள் "
"உள்ளனர்."

#, python-format
msgid "%(person_individual_name)s had a child."
msgid_plural "%(person_individual_name)s had %(child_count)s children."
msgstr[0] "%(person_individual_name)sு ஒரு குழந்தை இருந்தது."
msgstr[1] "%(person_individual_name)s %(child_count)s குழந்தைகள்."

#, python-format
msgid "%(person_individual_name)s is the child of %(parent_labels)s."
msgstr "%(person_individual_name)s என்பது %(parent_labels)s குழந்தை."

msgid ""
"A family history as told by <a "
"href=\"https://betty.readthedocs.io\">Betty👵</a>"
msgstr ""
"<a href=\"https://betty.readthedocs.io\">பெட்டி👵</a> கூறியது போல் குடும்ப வரலாறு"

msgid "API documentation"
msgstr "பநிஇ ஆவணங்கள்"

msgid "About"
msgstr "பற்றி"

msgid "Access denied"
msgstr "அணுகல் மறுக்கப்பட்டது"

#, python-format
msgid "Accessed %(date)s"
msgstr "அணுகப்பட்டது %(date)s"

msgid "Adoption"
msgstr "தத்தெடுப்பு"

msgid "All caches cleared."
msgstr "அனைத்து தற்காலிக சேமிப்புகளும் அழிக்கப்பட்டன."

msgid "All of these requirements must be met"
msgstr "இந்த தேவைகள் அனைத்தும் நிறைவு செய்யப்பட வேண்டும்"

msgid "All rights reserved"
msgstr "அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை"

#, python-format
msgid "Also known as %(names)s"
msgstr "%(names)s என்றும் அறியப்படுகிறது"

msgid "Ancestral names include"
msgstr "மூதாதையர் பெயர்கள் அடங்கும்"

msgid "Announcement of divorce"
msgstr "மணமுறிவு அறிவிப்பு"

msgid "Announcement of marriage"
msgstr "திருமண அறிவிப்பு"

msgid "Appearances"
msgstr "தோற்றங்கள்"

#, python-brace-format
msgid "At least {expected} items are required, but found {actual}."
msgstr ""
"குறைந்தபட்சம் {expected} உருப்படிகள் தேவை, ஆனால் {actual} கண்டறியப்பட்டது."

#, python-brace-format
msgid "At most {expected} items are allowed, but found {actual}."
msgstr ""
"அதிகபட்சம் {expected} உருப்படிகள் அனுமதிக்கப்படும், ஆனால் {actual} கண்டறியப்பட்டது."

msgid "At which URL will your site be published?"
msgstr "உங்கள் தளம் எந்த முகவரி இல் வெளியிடப்படும்?"

msgid "Attendee"
msgstr "பங்கேற்பாளர்"

msgid "Baptism"
msgstr "ஞானச்நானம்"

msgid "Bar mitzvah"
msgstr "பார் மிட்ச்வா"

msgid "Bat mitzvah"
msgstr "பேட் மிட்ச்வா"

msgid "Beneficiary"
msgstr "பயனாளி"

msgid "Betty could not load the SPDX licenses"
msgstr "பெட்டியால் SPDX உரிமங்களை ஏற்ற முடியவில்லை"

msgid ""
"Betty is an application that takes a family tree and builds a website out "
"of it, much like the one you are viewing right now. The more information "
"your genealogical research contains, the more interactivity Betty can add "
"to your site, such as media galleries, maps, and browsable family trees."
msgstr ""
"பெட்டி என்பது குடும்ப மரத்தை எடுத்து அதிலிருந்து இணையதளத்தை உருவாக்கும் ஒரு பயன்பாடாகும், "
"இது நீங்கள் இப்போது பார்த்துக் கொண்டிருப்பதைப் போன்றது. உங்கள் வம்சாவளி ஆராய்ச்சியில் உள்ள கூடுதல் "
"தகவல்கள், மீடியா கேலரிகள், வரைபடங்கள் மற்றும் உலாவக்கூடிய குடும்ப மரங்கள் போன்ற உங்கள் தளத்தில் "
"அதிக ஊடாடுதலை பெட்டி சேர்க்கலாம்."

#, python-brace-format
msgid ""
"Betty is unfamiliar with Gramps event \"{event_id}\"'s type of "
"\"{gramps_event_type}\". The event was imported, but its type was set to "
"\"{betty_event_type}\"."
msgstr ""
"பெட்டிக்கு கிராம்ப்ச் நிகழ்வு \"{event_id}\" இன் வகை \"{gramps_event_type}\" பற்றித் "
"தெரியாது. நிகழ்வு இறக்குமதி செய்யப்பட்டது, ஆனால் அதன் வகை \"{betty_event_type}\" என "
"அமைக்கப்பட்டது."

#, python-brace-format
msgid ""
"Betty is unfamiliar with Gramps file \"{file_id}\"'s copyright notice ID "
"of \"{copyright_notice_id}\" and ignored it."
msgstr ""
"பெட்டி \"{copyright_notice_id}\" இன் Gramps கோப்பு \"{file_id}\" இன் பதிப்புரிமை "
"அறிவிப்பு ஐடியைப் பற்றி அறிந்திருக்கவில்லை, மேலும் அதைப் புறக்கணித்தார்."

#, python-brace-format
msgid ""
"Betty is unfamiliar with Gramps file \"{file_id}\"'s license ID of "
"\"{license_id}\" and ignored it."
msgstr ""
"பெட்டி, Gramps கோப்பு \"{file_id}\" இன் \"{license_id}\" உரிம ஐடியைப் பற்றி "
"அறிந்திருக்கவில்லை, மேலும் அதைப் புறக்கணித்தார்."

#, python-brace-format
msgid ""
"Betty is unfamiliar with Gramps place \"{place_id}\"'s type of "
"\"{gramps_place_type}\". The place was imported, but its type was set to "
"\"{betty_place_type}\"."
msgstr ""
"பெட்டிக்கு கிராம்ப்ச் இடம் \"{place_id}\" இன் வகை \"{gramps_place_type}\" பற்றி "
"அறிமுகம் இல்லை. இடம் இறக்குமதி செய்யப்பட்டது, ஆனால் அதன் வகை \"{betty_place_type}\" என "
"அமைக்கப்பட்டது."

#, python-brace-format
msgid ""
"Betty is unfamiliar with person \"{person_id}\"'s Gramps presence role of "
"\"{gramps_presence_role}\" for the event with Gramps handle "
"\"{event_handle}\". The role was imported, but set to "
"\"{betty_presence_role}\"."
msgstr ""
"\"{person_id}\" என்ற நபரின் \"{gramps_presence_role}\" என்ற கிராம்ப்ச் ஏண்டில் உள்ள \""
"{event_handle}\" நிகழ்வில், பெட்டிக்கு அறிமுகம் இல்லை. பாத்திரம் இறக்குமதி செய்யப்பட்டது, "
"ஆனால் \"{betty_presence_role}\" என அமைக்கப்பட்டது."

#, python-format
msgid ""
"Betty was named after %(liberta_lankester_label)s, and this website shows "
"a small sample of her family history. You can browse the pages about her "
"and some of her family to get an idea of what a Betty site looks like."
msgstr ""
"பெட்டிக்கு %(liberta_lankester_label)s பெயரிடப்பட்டது, மேலும் இந்த இணையதளம் அவரது "
"குடும்ப வரலாற்றின் சிறிய மாதிரியைக் காட்டுகிறது. பெட்டி தளம் எப்படி இருக்கும் என்பதைப் "
"பற்றிய யோசனையைப் பெற நீங்கள் அவளைப் பற்றிய பக்கங்களையும் அவரது குடும்பத்தில் சிலரையும் "
"உலாவலாம்."

#, python-brace-format
msgid "Betty will talk to you in {locale}"
msgstr "பெட்டி உங்களுடன் {locale} இல் பேசுவார்"

msgid "Birth"
msgstr "பிறப்பு"

msgid "Borough"
msgstr "பெருநகரம்"

msgid "Building"
msgstr "கட்டிடம்"

msgid "Built the Webpack front-end assets."
msgstr "Webpack முன்-இறுதி சொத்துக்களை உருவாக்கியது."

msgid "Burial"
msgstr "அடக்கம்"

msgid "Cannot find an available port to bind the web server to."
msgstr ""
"இணைய சேவையகத்தை இணைக்க கிடைக்கக்கூடிய போர்ட்டைக் கண்டுபிடிக்க முடியவில்லை."

#, python-brace-format
msgid "Cannot find and import \"{plugin_id}\"."
msgstr "\"{plugin_id}\" ஐக் கண்டுபிடித்து இறக்குமதி செய்ய முடியவில்லை."

#, python-brace-format
msgid "Cannot find locale {locale}."
msgstr "{locale} மொழியைக் கண்டுபிடிக்க முடியவில்லை."

#, python-brace-format
msgid ""
"Cannot generate pages for {entity_type}, because it is not a user-facing "
"entity type."
msgstr ""
"{entity_type} க்கான பக்கங்களை உருவாக்க முடியாது, ஏனெனில் இது பயனர் எதிர்கொள்ளும் வகை அல்ல."

#, python-brace-format
msgid ""
"Cannot load Gramps file {file_id} with relative path {file_path}, because "
"your family tree does not include a base path. In Gramps, add a \"base "
"path for relative media paths\" to your family tree, and export it again."
msgstr ""
"உங்கள் குடும்ப மரத்தில் அடிப்படை பாதை இல்லாததால், Gramps கோப்பை {file_id} உடன் தொடர்புடைய "
"பாதையுடன் {file_path} ஏற்ற முடியாது. Gramps இல், உங்கள் குடும்ப மரத்தில் \"சார்ந்த மீடியா "
"பாதைகளுக்கான அடிப்படை பாதையை\" சேர்த்து, அதை மீண்டும் ஏற்றுமதி செய்யவும்."

#, python-brace-format
msgid "Cannot load Gramps file {file_id}, because {file_path} is not a file."
msgstr ""
"Gramps கோப்பை ஏற்ற முடியாது {file_id}, ஏனெனில் {file_path} ஒரு கோப்பு அல்ல."

#, python-brace-format
msgid ""
"Cannot load coordinates \"{coordinates}\", because they are in an unknown "
"format."
msgstr ""
"\"{coordinates}\" ஆயங்களை ஏற்ற முடியாது, ஏனெனில் அவை தெரியாத வடிவத்தில் உள்ளன."

msgid "Celebrant"
msgstr "கொண்டாடுபவர்"

msgid "Citation"
msgstr "மேற்கோள்"

msgid "Citations"
msgstr "மேற்கோள்கள்"

msgid "City"
msgstr "மாநகரம்"

msgid "Clear all caches"
msgstr "அனைத்து கேச்களையும் அழிக்கவும்"

msgid "Close"
msgstr "மூடு"

msgid "Conference"
msgstr "மாநாடு"

msgid "Configure Betty"
msgstr "பெட்டியை கட்டமைக்கவும்"

msgid "Confirmation"
msgstr "உறுதிப்படுத்தல்"

#, python-format
msgid "Continue reading on <a href=\"%(url)s\">Wikipedia</a>."
msgstr "<a href=\"%(url)s\">விக்கிபீடியாவில்</a> தொடர்ந்து படிக்கவும்."

msgid "Copyright"
msgstr "காப்புரிமை"

#, python-format
msgid "Copyright <a href=\"%(url)s\">OpenStreetMap</a> contributors"
msgstr "பதிப்புரிமை <a href=\"%(url)s\">OpenStreetMap</a> பங்களிப்பாளர்கள்"

msgid "Copyright Wikipedia contributors"
msgstr "பதிப்புரிமை விக்கிபீடியா பங்களிப்பாளர்கள்"

msgid ""
"Copyright of these works lies with the original authors who contributed "
"them to Wikipedia."
msgstr ""
"இந்தப் படைப்புகளின் காப்புரிமை விக்கிபீடியாவில் அவற்றைப் பங்களித்த அசல் ஆசிரியர்களிடம் உள்ளது."

msgid "Correspondence"
msgstr "கடிதப் பரிமாற்றம்"

msgid "Cotton Candy is Betty's legacy theme."
msgstr "பருத்தி மிட்டாய் என்பது பெட்டியின் பாரம்பரிய கருப்பொருள்."

#, python-brace-format
msgid "Could not extract {file_path} as a gzip file  (*.gz)."
msgstr "{file_path}ஐ gzip கோப்பாக (*.gz) பிரித்தெடுக்க முடியவில்லை."

#, python-brace-format
msgid "Could not extract {file_path} as a gzipped tar file  (*.tar.gz)."
msgstr ""
"சிசிப் செய்யப்பட்ட தார் கோப்பாக (*.tar.gz) {file_path} ஐப் பிரித்தெடுக்க முடியவில்லை."

#, python-brace-format
msgid "Could not find a plugin \"{plugin_id}\"."
msgstr "\"{plugin_id}\" செருகுநிரலைக் கண்டுபிடிக்க முடியவில்லை."

#, python-brace-format
msgid ""
"Could not find any of the following configuration files in "
"{project_directory_path}: {configuration_file_names}."
msgstr ""
"{project_directory_path} இல் பின்வரும் உள்ளமைவு கோப்புகள் எதையும் கண்டுபிடிக்க "
"முடியவில்லை: {configuration_file_names}."

#, python-brace-format
msgid "Could not find the file \"{file_path}\"."
msgstr "\"{file_path}\" கோப்பைக் கண்டுபிடிக்க முடியவில்லை."

#, python-brace-format
msgid ""
"Could not load \"{file_path}\" as a *.gpkg, a *.gramps, or an *.xml family"
" tree."
msgstr ""
"\"{file_path}\" ஐ *.gpkg, a *.gramps அல்லது *.xml குடும்ப மரமாக ஏற்ற முடியவில்லை."

msgid "Country"
msgstr "நாடு"

msgid "County"
msgstr "மாவட்டம்"

msgid "Create a new project"
msgstr "புதிய திட்டத்தை உருவாக்கவும்"

msgid "Create a new translation"
msgstr "புதிய மொழிபெயர்ப்பை உருவாக்கவும்"

msgid "Create a new translation for an extension"
msgstr "நீட்டிப்புக்கான புதிய மொழிபெயர்ப்பை உருவாக்கவும்"

msgid ""
"Create events such as births and deaths by deriving their details from "
