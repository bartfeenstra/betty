{% for content_configuration in content_configurations %}
    {% set content_provider = content_configuration.new_plugin_instance(project.content_provider_repository, factory=project.new_target) %}
    {% set content = content_provider.provide(
        job_context=job_context,
        locale=localizer.locale,
        page_resource=page_resource
    ) %}
    {% if content is not none %}
        {{ content | safe }}
    {% endif %}
{% endfor %}
