{% set view_padding %}
  {% include 'component/maps/view-padding.json.j2' %}
{% endset %}

{% set cluster_maximum_feature_distance %}
  {% include 'component/maps/cluster/maximum-feature-distance.json.j2' %}
{% endset %}

{% set cluster_minimum_cluster_distance %}
  {% include 'component/maps/cluster/minimum-cluster-distance.json.j2' %}
{% endset %}

{% set marker_place_anchor %}
  {% include 'component/maps/marker/place-anchor.json.j2' %}
{% endset %}

{% set ns = namespace(
  control_full_screen = {},
  control_zoom_in = {},
  control_zoom_out = {},
  selected_place = {}
) %}
{% for locale in project.locales.keys() %}
  {% with localizer = project.localizers.get(locale) %}
    {% set control_full_screen %}
      {% include 'component/maps/control/full-screen.html.j2' %}
    {% endset %}
    {% do ns.control_full_screen.setdefault(locale | to_language_tag, control_full_screen.strip()) %}

    {% set control_zoom_in %}
      {% include 'component/maps/control/zoom-in.html.j2' %}
    {% endset %}
    {% do ns.control_zoom_in.setdefault(locale | to_language_tag, control_zoom_in.strip()) %}

    {% set control_zoom_out %}
      {% include 'component/maps/control/zoom-out.html.j2' %}
    {% endset %}
    {% do ns.control_zoom_out.setdefault(locale | to_language_tag, control_zoom_out.strip()) %}

    {% set selected_place %}
      {% include 'component/maps/selected-place.html.j2' %}
    {% endset %}
    {% do ns.selected_place.setdefault(locale | to_language_tag, selected_place.strip()) %}
  {% endwith %}
{% endfor %}

{% set marker_place %}
  {% include 'component/maps/marker/place.svg.j2' %}
{% endset %}

{% set marker_place_selected %}
  {% include ['component/maps/marker/place--selected.svg.j2', 'component/maps/marker/place.svg.j2'] %}
{% endset %}

{% set marker_place_cluster %}
  {% include 'component/maps/marker/place-cluster.svg.j2' %}
{% endset %}

{% set marker_place_cluster_10 %}
  {% include ['component/maps/marker/place-cluster--10.svg.j2', 'component/maps/marker/place-cluster.svg.j2'] %}
{% endset %}

{% set marker_place_cluster_100 %}
  {% include ['component/maps/marker/place-cluster--100.svg.j2', 'component/maps/marker/place-cluster--10.svg.j2', 'component/maps/marker/place-cluster.svg.j2'] %}
{% endset %}

{% set marker_place_cluster_1000 %}
  {% include ['component/maps/marker/place-cluster--1000.svg.j2', 'component/maps/marker/place-cluster--100.svg.j2', 'component/maps/marker/place-cluster--10.svg.j2', 'component/maps/marker/place-cluster.svg.j2'] %}
{% endset %}

{{ {
  "viewPadding": view_padding.strip() | json_load,
  "clusterMaximumFeatureDistance": cluster_maximum_feature_distance.strip() | json_load,
  "clusterMinimumClusterDistance": cluster_minimum_cluster_distance.strip() | json_load,
  "fullScreenControlButtonHtml": ns.control_full_screen,
  "zoomInControlButtonHtml": ns.control_zoom_in,
  "zoomOutControlButtonHtml": ns.control_zoom_out,
  "selectedPlaceHtml": ns.selected_place,
  "markerPlaceAnchor": marker_place_anchor.strip() | json_load,
  "markerPlaceSvg": marker_place.strip(),
  "markerPlaceSelectedSvg": marker_place_selected.strip(),
  "markerPlaceCluster1Svg": marker_place_cluster.strip(),
  "markerPlaceCluster10Svg": marker_place_cluster_10.strip(),
  "markerPlaceCluster100Svg": marker_place_cluster_100.strip(),
  "markerPlaceCluster1000Svg": marker_place_cluster_1000.strip()
} | json_dump | safe }}
