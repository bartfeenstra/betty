{% cache 'raspberry-mint-template-footer:' ~ document.localizer.locale %}
    <div class="background-embellished py-5" data-bs-theme="dark-secondary">
        <div class="container">
            <div class="row">
                <div class="col col-12 col-lg-6 p-3">
                    {{ tag('p', project.copyright_notice.summary) }}
                    {{ tag('p', project.license.summary) }}
                </div>
                <div class="col col-12 col-lg-6 p-3">
                    {% if document.context %}
                        <p>
                            {% trans last_modified = document.context.start | format_datetime_datetime -%}
                                Last modified on {{ last_modified }}
                            {%- endtrans %}
                        </p>
                    {% endif %}
                    {% for link in secondary_navigation_links %}
                        <p>
                            {{ tag('a', link.label, html_href = link.url | url) }}
                        </p>
                    {% endfor %}
                </div>
            </div>
            <div class="d-flex justify-content-center">
                <div class="mt-3 pt-3 px-2 border-top border-white">
                    <small>
                        {% trans betty_url = about_url -%}
                            A family history as told by <a href="{{ betty_url }}">Betty👵</a>
                        {%- endtrans %}
                    </small>
                </div>
            </div>
        </div>
    </div>
{% endcache %}
