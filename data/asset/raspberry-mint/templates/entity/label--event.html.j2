{%- set embedded = embedded | default(False) -%}
{%- set person_context = document.entity_contexts['person'] -%}
{%- if entity.name -%}
    {%- set event_label = entity.name -%}
{%- elif entity.event_type -%}
    {%- set event_label = entity.event_type.definition.label -%}
{%- else -%}
    {%- set event_label = _('Unknown') -%}
{%- endif -%}
{%- set formatted_event = event_label | localize | html_lang | safe -%}
{%- if entity.id.persistent and not embedded -%}
    {%- set formatted_event -%}
        <a href="{{ entity | url }}">{{ formatted_event }}</a>
    {%- endset -%}
{%- endif -%}
{%- set subjects = entity.presences | selectattr('public') | selectattr('role', 'plugin', 'role', 'subject') | map(attribute='person') | selectattr('public') | list -%}
{%- set non_context_subjects = subjects | reject('eq', person_context) | list -%}
{% set ns = namespace(formatted_subjects = []) %}
{% for entity in non_context_subjects %}
    {% set formatted_subject %}{% include 'entity/label--person.html.j2' %}{% endset %}
    {% do ns.formatted_subjects.append(formatted_subject) %}
{% endfor %}
{%- set formatted_subjects = localizable_join_and(*ns.formatted_subjects) | localize | safe %}
{%- if non_context_subjects | length == 0 -%}
    {{ formatted_event }}
{%- else -%}
    {%- if person_context in subjects -%}
        {% trans event = formatted_event, subjects = formatted_subjects -%}
            {{ event }} with {{ subjects }}
        {%- endtrans %}
    {%- else -%}
        {% trans event = formatted_event, subjects = formatted_subjects -%}
            {{ event }} of {{ subjects }}
        {%- endtrans %}
    {%- endif -%}
{%- endif -%}
