{% extends 'base.html.j2' %}
{% set page_title = document.resource.label %}
{% set document = document.copy(entity_contexts=document.entity_contexts(document.resource)) %}
{% do document.breadcrumbs.append(
    document.resource.definition.label_plural,
    document.resource.definition if document.resource.definition.id in project.generate_entity_list_html else none
) %}
{% do document.breadcrumbs.append(
    page_title,
    document.resource
) %}
{% block page_content %}
{% endblock %}
